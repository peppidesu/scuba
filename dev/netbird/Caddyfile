{
	auto_https off
	admin off
	servers {
		protocols h1 h2 h2c   # NetBird clients speak gRPC over cleartext HTTP/2 in dev
	}
}

:8080 {
	@grpc path /signalexchange.SignalExchange/* /management.ManagementService/* /management.ProxyService/*
	handle @grpc {
		reverse_proxy h2c://netbird-server:80
	}

	@backend path /relay* /ws-proxy/* /api/* /oauth2/*
	handle @backend {
		reverse_proxy netbird-server:80
	}

	handle {
		reverse_proxy netbird-dashboard:80
	}
}
